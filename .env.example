# Copy this file to ".env" to run on your computer against a hosted database.
# Leave these two out to use a local file (stationery.db) instead.
TURSO_DATABASE_URL=libsql://your-database-name-your-account.turso.io
TURSO_AUTH_TOKEN=your-token

# Used only the very first time the database is created (afterwards change the password inside the app):
ADMIN_USER=admin
ADMIN_PASS=choose-a-strong-password
ADMIN_NAME=Miss Surjeet Kaur

# Optional: time zone as minutes ahead of UTC (India is 330, which is the default)
# TZ_OFFSET_MINUTES=330

# Optional email alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL=store@yourcollege.edu
